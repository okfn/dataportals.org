{% extends "base.njk" %}
{% block title %}Home{% endblock %}
{% block content %}
  <div class="page-header mb-4">
    <h1 class="display-4">
      Data Portals
      <small class="text-muted fs-6">A Comprehensive List of
        <a href="https://opendefinition.org/">Open Data</a>
        Portals from Around the World</small>
    </h1>
  </div>
  <div class="row home-map">
    <div class="col-12">
      <h3 class="heading">
        <a href="/search">{{ catalogs.length }} Data Portals listed &raquo;</a>
      </h3>
      <div class="query-editor-here"></div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <div id="overview-map"></div>
    </div>
  </div>
  <div class="row mt-4">
    <div class="col-12">
      <h3 class="heading">Not on the map</h3>
      <p class="text-muted">Portals that aren't tied to a specific geography, or whose location we don't have yet.</p>
      {# matches includePortalOnMap() in public/js/app.js #}
      <ul class="unmapped-portals">
        {% for catalog in catalogs | rejectattr("location") %}
          {% if catalog.status == "active" %}
            <li>
              <a href="/portal/{{ catalog.name }}/">{{ catalog.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
{% endblock %}
{% block scripts %}
  <script src="https://unpkg.com/maplibre-gl@^5.1.0/dist/maplibre-gl.js"></script>
  <script src="/js/app.js"></script>
  <link href="https://unpkg.com/maplibre-gl@^5.1.0/dist/maplibre-gl.css" rel="stylesheet"/>
{% endblock %}
